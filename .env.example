# 指向服务器已有 PostgreSQL；按实际账号、密码、地址、端口和数据库名修改。
DATABASE_URL=postgresql://db_user:db_password@127.0.0.1:5432/usstock
MIGRATIONS_DIR=migrations

SEC_USER_AGENT=usstock research contact@example.com
SEC_RATE_LIMIT_PER_SECOND=5
SEC_REQUEST_TIMEOUT_SECONDS=30
SEC_BASE_URL=https://data.sec.gov
SEC_ARCHIVES_BASE_URL=https://www.sec.gov/Archives

GDELT_DOC_BASE_URL=https://api.gdeltproject.org/api/v2/doc/doc
GDELT_RATE_LIMIT_PER_SECOND=0.2
GDELT_REQUEST_TIMEOUT_SECONDS=30

FINNHUB_API_KEY=change-me
FINNHUB_BASE_URL=https://finnhub.io/api/v1
FINNHUB_RATE_LIMIT_PER_SECOND=1
FINNHUB_REQUEST_TIMEOUT_SECONDS=30

# 管理面板默认只监听本机；如需公网直接访问，可改为 0.0.0.0，但建议先加防火墙白名单或反向代理鉴权。
USSTOCK_ADMIN_HOST=127.0.0.1
USSTOCK_ADMIN_PORT=7878

# 每日分析报告的可选 LLM 增强配置。
# 不配置也可以生成规则版报告；运行 `usstock report daily --use-llm` 时才需要。
REPORT_LLM_API_KEY=change-me
REPORT_LLM_BASE_URL=https://api.openai.com/v1
REPORT_LLM_MODEL=gpt-4.1-mini
REPORT_LLM_REQUEST_TIMEOUT_SECONDS=60
